# systemd unit - THE MINUTE
# Installation : sudo cp minute-server.service /etc/systemd/system/
#                sudo systemctl enable --now minute-server
[Unit]
Description=THE MINUTE - monument server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minute
WorkingDirectory=/opt/minute
ExecStart=/opt/minute/minute-server /opt/minute/config.json
Restart=always
RestartSec=5
# durcissement
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/minute/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
